#!/bin/sh
# 连接设备列表 v3（局部刷新 + 搜索排序 + 备注免跳转）  by au学长 V：aauuo0
#
# 相对 v2 的改动：
#   1. 页面只加载一次，之后每 N 秒用 fetch 只换 <tbody>（滚动位置、搜索词都不丢）
#   2. 备注保存走 ?save=1，同页更新，不再整页跳转
#   3. 主机名 / 备注 / MAC 全部 HTML 转义（含 < & " 的设备名不会破版）
#   4. 加统计条、搜索、点表头排序、信号强度条、手机卡片布局
#   5. 页面隐藏时停止刷新（省 CPU），可切换 5/10/30 秒或暂停

# 先不输出 HTTP 头：要等 QUERY_STRING 解析完，才知道这次是「页面 / ajax / 保存 / 诊断」

A=/tmp/_arp.txt
W=/tmp/_wifi.txt
ROWS=/tmp/_rows.html
M=/etc/device-names
[ -f "$M" ] || : >"$M"

# ---------- 工具 ----------
urldec() {
	awk '{ while (match($0,/%[0-9A-Fa-f][0-9A-Fa-f]/)) {
			n=0; for(i=1;i<=2;i++){ c=toupper(substr($0,RSTART+i,1)); n=n*16+index("0123456789ABCDEF",c)-1 }
			$0 = substr($0,1,RSTART-1) sprintf("\\%o",n) substr($0,RSTART+3) } gsub(/\+/," "); print }' \
		| xargs -0 printf '%b' 2>/dev/null || cat
}

# HTML 转义（先转 & 再转其它，顺序不能反）
esc() {
	printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' \
	                              -e 's/"/\&quot;/g' -e "s/'/\&#39;/g"
}

cname() { sed -n "s/^$1=//p" "$M" 2>/dev/null | head -n1; }

# ---------- 备注保存 ----------
qm="$(printf '%s' "$QUERY_STRING" | sed -n 's/.*mac=\([0-9a-fA-F:]*\).*/\1/p')"
qn="$(printf '%s' "$QUERY_STRING" | sed -n 's/.*name=\([^&]*\).*/\1/p' | urldec)"
qn="$(printf '%s' "$qn" | tr -d '|=<>&"'"'"'')"
qs="$(printf '%s' "$QUERY_STRING" | sed -n 's/.*save=1.*/1/p')"
if [ -n "$qm" ]; then
	grep -v "^$qm=" "$M" >"$M.tmp" 2>/dev/null
	[ -n "$qn" ] && printf '%s=%s\n' "$qm" "$qn" >>"$M.tmp"
	mv "$M.tmp" "$M" 2>/dev/null
	if [ "$qs" = "1" ]; then
		printf 'Content-Type: text/plain; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
		printf 'ok'
		exit 0
	fi
fi

# ---------- 采集：ARP ----------
awk 'NR>1 && $4!="00:00:00:00:00:00"{print tolower($4)}' /proc/net/arp 2>/dev/null | sort -u >"$A"
awk 'NR>1 && $4!="00:00:00:00:00:00"{print tolower($4)"|"$1}' /proc/net/arp 2>/dev/null >"$A.mac"

# ---------- 采集：无线 ----------
# 不再猜哪些是无线接口（旧版靠 /sys/class/net/*/phy80211，名字或 symlink 一变就全漏，
# 结果 2.4G 客户端全被当成网线）。改成遍历所有接口，谁能 dump 出站点就用谁。
: >"$W"
for ifc in $(ls /sys/class/net 2>/dev/null); do
	[ "$ifc" = "lo" ] && continue

	# 这个接口是 2.4G 还是 5G（按频率判断，>=4000MHz 算 5G）
	band=2.4G
	freq="$(iw dev "$ifc" info 2>/dev/null | sed -n 's/.*channel [0-9]* (\([0-9]*\) MHz).*/\1/p' | head -n1)"
	if [ -z "$freq" ]; then
		freq="$(iwinfo "$ifc" info 2>/dev/null | sed -n 's/.*(\([0-9.]*\) GHz).*/\1/p' | head -n1)"
		[ -n "$freq" ] && freq="$(awk -v g="$freq" 'BEGIN{printf "%d", g*1000}')"
	fi
	[ -n "$freq" ] && [ "$freq" -ge 4000 ] 2>/dev/null && band=5G

	n0="$(wc -l <"$W" 2>/dev/null || echo 0)"
	if command -v iw >/dev/null 2>&1; then
		iw dev "$ifc" station dump 2>/dev/null | awk -v b="$band" '
			/^Station/ { if (m) print m"|"b"|"sig"|"rate; m=tolower($2); sig="-"; rate="-" }
			/signal:/    { sig=$2 } /rx bitrate:/ { rate=$3 }
			END { if (m) print m"|"b"|"sig"|"rate }' >>"$W"
	fi
	n1="$(wc -l <"$W" 2>/dev/null || echo 0)"
	# iw 没给出站点（或本机没有 iw）就用 iwinfo 兜底，而不是二选一
	if [ "$n1" -le "$n0" ] && command -v iwinfo >/dev/null 2>&1; then
		iwinfo "$ifc" assoclist 2>/dev/null | grep -E '^([0-9a-fA-F]{2}:){5}' | \
			awk -v b="$band" '{ print tolower($1)"|"b"|"$2"|"$3" "$4 }' >>"$W"
	fi
done
sort -u "$W" >"$W.s" 2>/dev/null && mv "$W.s" "$W" 2>/dev/null

# 诊断：/cgi-bin/devices?diag=1 —— 把看到的接口、频段、站点数原样吐出来
if [ -n "$(printf '%s' "$QUERY_STRING" | sed -n 's/.*diag=1.*/y/p')" ]; then
	printf 'Content-Type: text/plain; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
	echo "# interfaces（名字 / 频段 / iw 能 dump 出的站点数）"
	for ifc in $(ls /sys/class/net 2>/dev/null); do
		f="$(iw dev "$ifc" info 2>/dev/null | sed -n 's/.*channel [0-9]* (\([0-9]*\) MHz).*/freq=\1/p' | head -n1)"
		st="$(iw dev "$ifc" station dump 2>/dev/null | grep -c '^Station')"
		[ "$st" = "0" ] && [ -z "$f" ] && continue
		echo "$if	${f:-freq=?}	stations=$st"
	done
	echo
	echo "# iw 分支采到的站点（mac|band|signal|rate）共 $(wc -l <"$W") 条"
	head -n 40 "$W"
	echo
	echo "# dhcp leases"
	head -n 15 /tmp/dhcp.leases 2>/dev/null
	echo
	echo "# arp"
	head -n 15 /proc/net/arp 2>/dev/null
	rm -f "$A" "$A.mac" "$W" "$ROWS" "$ROWS.seen"
	exit 0
fi

oui() {
	case "$1" in
		a8:5c:2c|f0:18:98|dc:a9:04|9c:35:eb|3c:2e:f9|b8:8d:12|f4:0f:24|7c:d1:c3|ac:bc:32|d0:81:7a) echo 苹果 ;;
		28:6c:07|64:cc:2e|78:11:dc|50:8f:4c|8c:53:c3|f0:b4:29|10:2a:b3|34:ce:00|64:09:80) echo 安卓 ;;
		00:15:5d|00:50:56|00:0c:29|b8:27:eb|dc:a6:32) echo 电脑 ;;
		*) echo "" ;;
	esac
}
classify() {
	local o
	o="$(oui "$1")"; [ -n "$o" ] && { echo "$o"; return; }
	case "$2" in
		*iPhone*|*iPad*|*iPod*|*MacBook*|*Mac-*|*Apple*|*apple*) echo 苹果 ;;
		*DESKTOP*|*desktop*|*LAPTOP*|*laptop*|*WIN-*|*Win-*|*PC-*) echo Windows ;;
		*android*|*Android*|*Redmi*|*redmi*|*Xiaomi*|*xiaomi*|*MI-*|*HUAWEI*|*HONOR*|*OPPO*|*vivo*|*VIVO*|*OnePlus*|*realme*|*Galaxy*|*SM-*) echo 安卓 ;;
		*OpenWrt*|*Router*|*AP*) echo 路由 ;;
		*) echo 未知 ;;
	esac
}
wifi_of() { grep -m1 "^$1|" "$W" 2>/dev/null; }

# ---------- 行输出 ----------
: >"$ROWS"
n_on=0; n_off=0; n_5g=0; n_24=0; n_wan=0; n_all=0

row() { # $1=mac $2=ip $3=name $4=online(1/0) $5=hasdhcp(1/0)
	local mac ip name on hd t cn wi b sig rt conn kb cls pct
	mac="$1"; ip="$2"; name="$3"; on="$4"; hd="$5"

	t="$(classify "$mac" "$name")"
	cn="$(cname "$mac")"
	[ -n "$cn" ] && name="$cn"
	if [ -z "$name" ] || [ "$name" = "*" ]; then
		if [ "$hd" = "1" ]; then name="（未命名设备）"; else name="（无 DHCP 记录，可能是静态 IP）"; fi
	fi

	case "$t" in
		苹果) kb=apple ;; 安卓) kb=android ;; Windows) kb=win ;; 电脑) kb=pc ;; 路由) kb=router ;; *) kb=unk ;;
	esac

	wi="$(wifi_of "$mac")"
	if [ -n "$wi" ]; then
		b="$(printf '%s' "$wi" | cut -d'|' -f2)"
		sig="$(printf '%s' "$wi" | cut -d'|' -f3)"
		rt="$(printf '%s' "$wi" | cut -d'|' -f4)"
		case "$b" in 5G) conn='<span class="b b5">WiFi 5G</span>'; n_5g=$((n_5g+1)) ;; *) conn='<span class="b b24">WiFi 2.4G</span>'; n_24=$((n_24+1)) ;; esac
	else
		conn='<span class="b bwan">网线</span>'; sig="-"; rt="-"; n_wan=$((n_wan+1))
	fi
	[ -z "$rt" ] && rt="-"

	if [ "$on" = "1" ]; then n_on=$((n_on+1)); else n_off=$((n_off+1)); fi
	n_all=$((n_all+1))

	# 信号强度条：-30dBm=100%，-90dBm=0%
	pct=0
	case "$sig" in
		-*[0-9]*) pct=$(( (sig + 90) * 100 / 60 )); [ "$pct" -lt 3 ] && pct=3; [ "$pct" -gt 100 ] && pct=100 ;;
	esac

	printf '<tr data-on="%s" data-kb="%s" data-ip="%s" data-sig="%s" data-name="%s">' \
		"$on" "$kb" "$ip" "$sig" "$(esc "$name")" >>"$ROWS"
	printf '<td data-k="状态">%s</td>' "$([ "$on" = "1" ] && echo '<span class="dot on"></span>在线' || echo '<span class="dot off"></span>离线')" >>"$ROWS"
	printf '<td data-k="类型"><span class="kb k-%s">%s</span></td>' "$kb" "$(esc "$t")" >>"$ROWS"
	printf '<td data-k="名称" class="nm">%s</td>' "$(esc "$name")" >>"$ROWS"
	printf '<td data-k="IP"><code>%s</code></td>' "$(esc "$ip")" >>"$ROWS"
	printf '<td data-k="MAC"><code class="mac">%s</code></td>' "$(esc "$mac")" >>"$ROWS"
	printf '<td data-k="连接">%s</td>' "$conn" >>"$ROWS"
	if [ "$pct" -gt 0 ]; then
		printf '<td data-k="信号"><span class="sigwrap"><span class="sigbar"><i style="width:%s%%"></i></span><code>%s</code></span></td>' "$pct" "$(esc "$sig")" >>"$ROWS"
	else
		printf '<td data-k="信号"><code>-</code></td>' >>"$ROWS"
	fi
	printf '<td data-k="速率"><code>%s</code></td>' "$(esc "$rt")" >>"$ROWS"
	printf '<td data-k="备注"><input class="rn" placeholder="备注" value="%s" data-mac="%s"></td>' "$(esc "$cn")" "$(esc "$mac")" >>"$ROWS"
	printf '</tr>\n' >>"$ROWS"
}

# DHCP 租约（有主机名）
if [ -s /tmp/dhcp.leases ]; then
	while read -r ts mac ip name _; do
		[ -n "$ip" ] || continue
		[ "$ip" = "192.168.1.1" ] && continue
		lm=$(printf '%s' "$mac" | tr 'A-Z' 'a-z')
		echo "$lm" >>"$ROWS.seen"
		if grep -q "^$lm$" "$A"; then on=1; else on=0; fi
		row "$lm" "$ip" "$name" "$on" 1
	done < /tmp/dhcp.leases
fi

# ARP 里有、DHCP 没记录（静态 IP）
if [ -s "$A.mac" ]; then
	while IFS='|' read -r lm ip; do
		[ -n "$ip" ] || continue
		[ "$ip" = "192.168.1.1" ] && continue
		[ -f "$ROWS.seen" ] && grep -q "^$lm$" "$ROWS.seen" && continue
		row "$lm" "$ip" "" 1 0
	done <"$A.mac"
fi

# ---------- 输出 ----------
if [ "$1" = "ajax" ] || [ "$aj" = "1" ] || [ -n "$(printf '%s' "$QUERY_STRING" | sed -n 's/.*ajax=1.*/y/p')" ]; then
	printf 'Content-Type: text/html; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
	cat "$ROWS"
	rm -f "$A" "$A.mac" "$W" "$ROWS" "$ROWS.seen"
	exit 0
fi

printf 'Content-Type: text/html; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'

cat <<'EOF'
