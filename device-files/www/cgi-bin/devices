#!/bin/sh
# 连接设备可视化列表 v2（主机名 / 设备类型 / 连接方式）  by au学长 V：aauuo0
printf 'Content-Type: text/html; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'

A=/tmp/_arp.txt; W=/tmp/_wifi.txt
M=/etc/device-names
[ -f "$M" ] || : >"$M"
# URL 解码（支持中文：%XX 先转成八进制转义，再交给 printf %b 输出原始字节）
urldec() {
	awk '{ while (match($0,/%[0-9A-Fa-f][0-9A-Fa-f]/)) {
			n=0; for(i=1;i<=2;i++){ c=toupper(substr($0,RSTART+i,1)); n=n*16+index("0123456789ABCDEF",c)-1 }
			$0 = substr($0,1,RSTART-1) sprintf("\\%o",n) substr($0,RSTART+3) }
		gsub(/\+/," "); print }' | xargs -0 printf '%b' 2>/dev/null || cat
}
# 保存备注：/cgi-bin/devices?mac=xx:xx&name=xxx
qm="$(printf '%s' "$QUERY_STRING" | sed -n 's/.*mac=\([0-9a-fA-F:]*\).*/\1/p')"
qn="$(printf '%s' "$QUERY_STRING" | sed -n 's/.*name=\([^&]*\).*/\1/p' | urldec)"
qn="$(printf '%s' "$qn" | tr -d '|=<>&"'"'"'')"
if [ -n "$qm" ]; then
	grep -v "^$qm=" "$M" >"$M.tmp" 2>/dev/null
	[ -n "$qn" ] && echo "$qm=$qn" >>"$M.tmp"
	mv "$M.tmp" "$M" 2>/dev/null
fi
cname() { sed -n "s/^$1=//p" "$M" 2>/dev/null | head -n1; }
form() { # $1=mac $2=当前备注
	printf '<form method=get style="display:flex;gap:4px;margin:0"><input type=hidden name=mac value="%s"><input name=name value="%s" size=8 placeholder="备注" style="background:#1d2129;border:1px solid #333;color:#ddd;border-radius:4px;padding:2px 5px;width:78px"><button style="background:#2a3140;color:#dfe6f0;border:0;border-radius:4px;padding:3px 8px">存</button></form>' "$1" "$2"
}
awk 'NR>1 && $4!="00:00:00:00:00:00"{print tolower($4)}' /proc/net/arp 2>/dev/null | sort -u >"$A"
awk 'NR>1 && $4!="00:00:00:00:00:00"{print tolower($4)"|"$1}' /proc/net/arp 2>/dev/null >"$A.mac"
: >"$W"
# 无线接口：不靠名字猜（24.10 里叫 phy0-ap0 也很常见），用 phy80211 标记来找
WIFIS="$(ls -d /sys/class/net/*/phy80211 2>/dev/null | sed 's#.*/net/\(.*\)/phy80211#\1#')"
[ -z "$WIFIS" ] && WIFIS="$(ls /sys/class/net 2>/dev/null | grep -E '^(wlan|phy)' | grep -v '\.')"
for w in $WIFIS; do
	# 频段：按频率判断（>=4000MHz 就是 5G），比按信道号/接口名都稳
	band=2.4G
	freq="$(iw dev "$w" info 2>/dev/null | sed -n 's/.*channel [0-9]* (\([0-9]*\) MHz).*/\1/p' | head -n1)"
	if [ -z "$freq" ]; then
		freq="$(iwinfo "$w" info 2>/dev/null | sed -n 's/.*(\([0-9.]*\) GHz).*/\1/p' | head -n1)"
		[ -n "$freq" ] && freq="$(awk -v g="$freq" 'BEGIN{printf "%d", g*1000}')"
	fi
	[ -n "$freq" ] && [ "$freq" -ge 4000 ] 2>/dev/null && band=5G
	if command -v iw >/dev/null 2>&1; then
		iw dev "$w" station dump 2>/dev/null | awk -v b="$band" '
			/^Station/ { if (m) print m"|"b"|"sig"|"rate; m=$2; sig="-"; rate="-" }
			/signal:/    { sig=$2 } /rx bitrate:/ { rate=$3 }
			END { if (m) print m"|"b"|"sig"|"rate }' >>"$W"
	elif command -v iwinfo >/dev/null 2>&1; then
		iwinfo "$w" assoclist 2>/dev/null | grep -E '^([0-9a-fA-F]{2}:){5}' | \
			awk -v b="$band" '{ print $1"|"b"|"$2"|"$3" "$4 }' >>"$W"
	fi
done

# MAC 前三位（OUI）粗判厂商
oui() {
	case "$1" in
		a8:5c:2c|f0:18:98|dc:a9:04|9c:35:eb|3c:2e:f9|b8:8d:12|f4:0f:24|7c:d1:c3|ac:bc:32|d0:81:7a) echo 苹果 ;;
		28:6c:07|64:cc:2e|78:11:dc|50:8f:4c|8c:53:c3|f0:b4:29|10:2a:b3|34:ce:00|64:09:80) echo 安卓 ;;
		00:15:5d|00:50:56|00:0c:29|b8:27:eb) echo 电脑 ;;
		*) echo "" ;;
	esac
}
classify() {  # $1=mac $2=主机名
	o="$(oui "$1")"; [ -n "$o" ] && { echo "$o"; return; }
	case "$2" in
		*iPhone*|*iPad*|*iPad*|*iPod*|*MacBook*|*Mac-*|*Apple*|*apple*) echo 苹果 ;;
		*DESKTOP*|*desktop*|*LAPTOP*|*laptop*|*WIN-*|*Win-*|*PC-*) echo Windows ;;
		*android*|*Android*|*Redmi*|*redmi*|*Xiaomi*|*xiaomi*|*MI-*|*HUAWEI*|*HONOR*|*OPPO*|*vivo*|*VIVO*|*OnePlus*|*realme*|*Galaxy*|*SM-*) echo 安卓 ;;
		*OpenWrt*|*Router*|*AP*) echo 路由/AP ;;
		*) echo 未知 ;;
	esac
}
wifi_of() { grep -m1 "^$1|" "$W" 2>/dev/null; }

cat <<'EOF'
<!DOCTYPE html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="refresh" content="8">
<title>连接设备</title><style>
body{font-family:-apple-system,"Microsoft YaHei",sans-serif;margin:16px;background:#11141a;color:#e9e9e9}
h2{margin:0 0 4px}h3{margin:18px 0 8px;font-size:15px;color:#9ab}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{text-align:left;padding:7px 8px;border-bottom:1px solid #232a36}
th{color:#8ea;font-weight:600;font-size:13px}
.on{color:#3c9}.off{color:#778}
.t-苹果{color:#e58}.t-安卓{color:#5c8}.t-Windows{color:#7af}.t-未知{color:#889}
.c5{color:#7af}.c24{color:#fc6}.cwan{color:#9ad}.m{font-family:ui-monospace,Consolas,monospace;font-size:12.5px;color:#aab}
.wm{position:fixed;right:12px;bottom:8px;color:#556;font-size:12px}
</style></head><body>
<h2>连接设备</h2>
<p style="color:#889;font-size:13px;margin:0">作者：au学长 V：aauuo0　（每 8 秒自动刷新；设备类型按主机名 + MAC 厂商粗判，仅供参考）</p>
<div class="wm">作者：au学长 V：aauuo0</div>
<h3>设备列表</h3>
<table><tr><th>状态</th><th>设备类型</th><th>主机名 / 设备名称</th><th>IP</th><th>MAC</th><th>连接方式</th><th>信号</th><th>速率</th><th>备注（自己起名）</th></tr>
EOF

seen=/tmp/_seen.txt; : >"$seen"
if [ -s /tmp/dhcp.leases ]; then
	while read -r ts mac ip name _; do
		[ -n "$ip" ] || continue
		[ "$ip" = "192.168.1.1" ] && continue
		lm=$(printf '%s' "$mac" | tr 'A-Z' 'a-z'); echo "$lm" >>"$seen"
		st='<span class=off>离线</span>'; grep -q "^$lm$" "$A" && st='<span class=on>在线</span>'
		[ -n "$name" ] && [ "$name" != "*" ] || name="（未命名设备）"
		cn="$(cname "$lm")"; [ -n "$cn" ] && name="$cn"
		t="$(classify "$lm" "$name")"
		wi="$(wifi_of "$lm")"
		if [ -n "$wi" ]; then
			b="$(printf '%s' "$wi" | cut -d'|' -f2)"; sig="$(printf '%s' "$wi" | cut -d'|' -f3)"; rt="$(printf '%s' "$wi" | cut -d'|' -f4)"
			case "$b" in 5G) conn='<span class=c5>WiFi 5G</span>' ;; *) conn='<span class=c24>WiFi 2.4G</span>' ;; esac
		else
			conn='<span class=cwan>网线</span>'; sig="-"; rt="-"
		fi
		printf '<tr><td>%s</td><td class="t-%s"><b>%s</b></td><td>%s</td><td>%s</td><td class="m">%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>\n' \
			"$st" "$t" "$t" "$name" "$ip" "$mac" "$conn" "$sig" "$rt" "$(form "$lm" "$cn")"
	done < /tmp/dhcp.leases
fi

# ARP 里有、但 DHCP 没记录的（静态 IP 设备）
if [ -s "$A.mac" ]; then
	while IFS='|' read -r lm ip; do
		[ "$ip" = "192.168.1.1" ] && continue
		grep -q "^$lm$" "$seen" && continue
		t="$(classify "$lm" "")"
		cn="$(cname "$lm")"
		wi="$(wifi_of "$lm")"
		if [ -n "$wi" ]; then
			b="$(printf '%s' "$wi" | cut -d'|' -f2)"; sig="$(printf '%s' "$wi" | cut -d'|' -f3)"; rt="$(printf '%s' "$wi" | cut -d'|' -f4)"
			case "$b" in 5G) conn='<span class=c5>WiFi 5G</span>' ;; *) conn='<span class=c24>WiFi 2.4G</span>' ;; esac
		else
			conn='<span class=cwan>网线</span>'; sig="-"; rt="-"
		fi
		printf '<tr><td><span class=on>在线</span></td><td class="t-%s"><b>%s</b></td><td>%s</td><td>%s</td><td class="m">%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>\n' \
			"$t" "$t" "$([ -n "$cn" ] && echo "$cn" || echo "（无 DHCP 记录，可能是静态 IP）")" "$ip" "$lm" "$conn" "$sig" "$rt" "$(form "$lm" "$cn")"
	done <"$A.mac"
fi
cat <<'EOF'
</table>
<p style="color:#667;font-size:12px;margin-top:14px">数据来源：/tmp/dhcp.leases（主机名）、/proc/net/arp（在线）、iw station dump（无线频段/信号/速率）；MAC 厂商仅收录常用段，判断不准时以主机名为准。</p>
</body></html>
EOF
rm -f "$A" "$A.mac" "$W" "$seen"
