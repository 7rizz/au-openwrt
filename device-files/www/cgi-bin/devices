cat "$ROWS"

cat <<'EOF'
</tbody></table></div>

<p class="foot">备注存在 /etc/device-names，重启不丢。</p>

<script>
(function(){
  var tbody = document.getElementById('rows');
  var q     = document.getElementById('q');
  var ivSel = document.getElementById('iv');
  var stat  = document.getElementById('stats');
  var timer = null;
  var lastSort = null;

  function rows(){ return [].slice.call(tbody.querySelectorAll('tr')); }

  function updateStats(){
    var r = rows(), on = 0, g5 = 0, g24 = 0;
    r.forEach(function(tr){
      if (tr.getAttribute('data-on') === '1') on++;
      var c = tr.querySelector('.b5');  if (c) g5++;
      var d = tr.querySelector('.b24'); if (d) g24++;
    });
    stat.innerHTML = '在线 <b>' + on + '</b> / 共 <b>' + r.length + '</b> 台'
                   + '　5G <b>' + g5 + '</b>　2.4G <b>' + g24 + '</b>';
  }

  function applyFilter(){
    var k = (q.value || '').trim().toLowerCase();
    rows().forEach(function(tr){
      var hay = (tr.getAttribute('data-name') || '') + ' ' + (tr.getAttribute('data-ip') || '')
              + ' ' + (tr.querySelector('.mac') ? tr.querySelector('.mac').textContent : '');
      tr.style.display = (!k || hay.toLowerCase().indexOf(k) >= 0) ? '' : 'none';
    });
    updateStats();
  }

  function sortBy(key, dir){
    var list = rows();
    list.sort(function(a, b){
      var va = a.getAttribute('data-' + key) || '', vb = b.getAttribute('data-' + key) || '';
      if (key === 'sig'){ va = parseInt(va, 10) || -999; vb = parseInt(vb, 10) || -999; return (va - vb) * dir; }
      if (key === 'on'){ va = va === '1' ? 0 : 1; vb = vb === '1' ? 0 : 1; return (va - vb) * dir; }
      if (key === 'ip'){
        var pa = va.split('.').map(Number), pb = vb.split('.').map(Number);
        for (var i = 0; i < 4; i++){ if ((pa[i]||0) !== (pb[i]||0)) return ((pa[i]||0) - (pb[i]||0)) * dir; }
        return 0;
      }
      return va.localeCompare(vb, 'zh') * dir;
    });
    list.forEach(function(tr){ tbody.appendChild(tr); });
  }

  document.querySelectorAll('th[data-s]').forEach(function(th){
    th.addEventListener('click', function(){
      var key = th.getAttribute('data-s');
      var dir = th.classList.contains('asc') ? -1 : 1;
      document.querySelectorAll('th[data-s]').forEach(function(o){ o.classList.remove('asc','desc'); });
      th.classList.add(dir === 1 ? 'asc' : 'desc');
      lastSort = { key: key, dir: dir };
      sortBy(key, dir);
    });
  });

  function saveName(inp){
    var mac = inp.getAttribute('data-mac');
    var val = encodeURIComponent(inp.value || '');
    fetch('/cgi-bin/devices?save=1&mac=' + encodeURIComponent(mac) + '&name=' + val, { cache: 'no-store' })
      .then(function(r){ return r.text(); })
      .then(function(t){
        if (t.trim() !== 'ok') return;
        var tr = inp.closest('tr');
        if (tr){ tr.setAttribute('data-name', inp.value || ''); }
        var nm = tr && tr.querySelector('.nm');
        if (nm && inp.value) nm.textContent = inp.value;
        if (!inp.value) { refresh(); return; }
        inp.classList.add('saved'); setTimeout(function(){ inp.classList.remove('saved'); }, 800);
      });
  }

  tbody.addEventListener('keydown', function(e){
    var t = e.target;
    if (t && t.classList.contains('rn') && (e.key === 'Enter' || e.keyCode === 13)){
      e.preventDefault(); t.blur(); saveName(t);
    }
  });
  tbody.addEventListener('change', function(e){
    var t = e.target;
    if (t && t.classList.contains('rn')) saveName(t);
  });

  function refresh(){
    if (document.hidden) return;
    fetch('/cgi-bin/devices?ajax=1', { cache: 'no-store' })
      .then(function(r){ return r.text(); })
      .then(function(html){
        if (!html) return;
        tbody.innerHTML = html;
        applyFilter();
        if (lastSort) sortBy(lastSort.key, lastSort.dir);
      })
      .catch(function(){});
  }

  function restart(){
    if (timer) { clearInterval(timer); timer = null; }
    var s = parseInt(ivSel.value, 10);
    if (s > 0) timer = setInterval(refresh, s * 1000);
  }

  ivSel.addEventListener('change', restart);
  document.getElementById('rf').addEventListener('click', refresh);
  q.addEventListener('input', applyFilter);
  document.addEventListener('visibilitychange', function(){ if (!document.hidden) refresh(); });

  applyFilter();
  restart();
})();
</script>
</body></html>
