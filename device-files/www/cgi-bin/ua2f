#!/bin/sh
# UA2F 最简网页管理界面（CGI，by au学长 V：aauuo0）
# 放到 /www/cgi-bin/ua2f 并 chmod 755，浏览器开 http://路由器IP/cgi-bin/ua2f

QS="$QUERY_STRING"
A="$(printf '%s' "$QS" | sed -n 's/.*a=\([a-z_0-9]*\).*/\1/p')"
OUT=""
case "$A" in
	persona_windows|persona_iphone|persona_android|persona_mac|ttl_on|ttl_off|start|stop|restart)
		OUT="$(/usr/libexec/ua2f-web "$A" 2>&1)"
		sleep 2
		;;
esac

ST="$(/usr/libexec/ua2f-web status 2>/dev/null)"
val() { printf '%s\n' "$ST" | sed -n "s/^$1=//p"; }
R="$(val running)"; P="$(val persona)"; T="$(val ttl)"; UA="$(val ua_full)"

printf 'Content-Type: text/html; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
cat <<EOF
<!DOCTYPE html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>UA2F 防检测</title>
<style>
body{font-family:-apple-system,"Microsoft YaHei",sans-serif;margin:18px;background:#11141a;color:#e9e9e9;line-height:1.6}
h2{margin:0 0 12px} h3{margin:18px 0 8px;font-size:15px;color:#9ab}
a.b{display:inline-block;padding:9px 14px;margin:0 8px 8px 0;border-radius:6px;background:#2a3140;color:#dfe6f0;text-decoration:none;font-size:15px}
a.b:hover{background:#39435a}
.k{color:#8ea} .run{color:#3c9} .no{color:#c93}
pre{background:#1b2029;padding:10px;border-radius:6px;white-space:pre-wrap;word-break:break-all}
.ua{color:#93a;word-break:break-all;font-size:13px}
.wmtile{position:fixed;left:0;right:0;top:40%;text-align:center;pointer-events:none;z-index:0;
	color:rgba(255,255,255,.055);font-size:64px;font-weight:700;transform:rotate(-22deg);white-space:nowrap;user-select:none}
.wm{position:fixed;right:12px;bottom:8px;color:#556;font-size:12px;z-index:9;user-select:none}
.wrap{position:relative;z-index:1}
</style></head><body>
<div class="wmtile">作者：au学长 V：aauuo0</div>
<div class="wm">作者：au学长 V：aauuo0</div>
<div class="wrap">
<h2>UA2F 防检测</h2>
<p>状态：$( [ "$R" = "1" ] && echo '<span class=run>● 运行中</span>' || echo '<span class=no>● 未运行</span>' )
　人格：<span class=k>$P</span>　固定 TTL：<span class=k>$T</span></p>
<p class=ua>当前 UA：$UA</p>
$( [ -n "$OUT" ] && printf '<pre>%s</pre>' "$OUT" )

<h3>切换人格（UA 和 TTL 一起切）</h3>
<p>
<a class=b href="?a=persona_windows">Windows　TTL 128</a>
<a class=b href="?a=persona_iphone">iPhone　TTL 64</a>
<a class=b href="?a=persona_android">Android　TTL 64</a>
<a class=b href="?a=persona_mac">Mac　TTL 64</a>
</p>

<h3>其他</h3>
<p>
<a class=b href="?a=ttl_on">按人格重设 TTL</a>
<a class=b href="?a=ttl_off">关闭 TTL 固定</a>
<a class=b href="?a=restart">重启 UA2F</a>
<a class=b href="?a=start">启动</a>
<a class=b href="?a=stop">停止</a>
<a class=b href="./ua2f">刷新</a>
</p>

<p style="color:#889;font-size:13px">验证是否生效：
<a href="/ua-check.html" style="color:#7af">打开 UA 检测页</a>
（显示"服务器获取的UA"应该等于上面的人格，不是设备的真实 UA）</p>
</div>
</body></html>
EOF
