#!/bin/sh
# 网络环境 / 波动监测（对游戏延迟）    by au学长 V：aauuo0
LOG=/tmp/netmon.log
GW="$(ip route show default 2>/dev/null | awk '/^default/{print $3;exit}')"
D1=223.5.5.5        # 阿里 DNS（国内骨干）
D2=119.29.29.29     # 腾讯 DNS（游戏走得近）
IF="$(ip route show default 2>/dev/null | awk '/^default/{print $5;exit}')"

m() {  # $1=host -> "avg|loss"
	o="$(ping -c 5 -W 1 -q "$1" 2>/dev/null)"
	a="$(printf '%s' "$o" | sed -n 's#.*=\s*[0-9.]*/\([0-9.]*\)/.*#\1#p' | head -n1)"
	l="$(printf '%s' "$o" | sed -n 's/.*, *\([0-9]*\)% packet loss.*/\1/p' | head -n1)"
	[ -n "$a" ] || a=0
	echo "${a}|${l:-100}"
}
rate() {  # WAN 收发速率（KB/s），用两次采样差值
	[ -z "$IF" ] && { echo "0|0"; return; }
	cur="$(awk -v i="$IF:" '$1==i{gsub(/^ +/,"",$2); print $2" "$10}' /proc/net/dev 2>/dev/null)"
	prev="$(cat /tmp/netmon.prev 2>/dev/null)"
	printf '%s' "$cur" >/tmp/netmon.prev
	printf '%s\n%s\n' "$prev" "$cur" | awk 'NR==1{rx=$1;tx=$2} NR==2{d1=$1-rx;d2=$2-tx; if(d1<0)d1=0; if(d2<0)d2=0; printf "%.0f|%.0f", d1/1024/5, d2/1024/5}'
}

q="$(printf '%s' "$QUERY_STRING")"
case "$q" in
	clear) : >"$LOG";;
	*)
		[ -z "$q" ] || [ "$q" = "run" ] || [ "$q" = "?run" ] || q=run
		g="$(m "$GW")"; d1="$(m "$D1")"; d2="$(m "$D2")"; r="$(rate)"
		printf '%s|%s|%s|%s|%s|%s\n' "$(date +%H:%M:%S)" "$g" "$d1" "$d2" "$r" >>"$LOG"
		tail -n 60 "$LOG" >"$LOG.t" && mv "$LOG.t" "$LOG"
		;;
esac

printf 'Content-Type: text/html; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
cat <<'EOF'
<!DOCTYPE html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="refresh" content="10">
<title>网络波动监测</title><style>
body{font-family:-apple-system,"Microsoft YaHei",sans-serif;margin:16px;background:#11141a;color:#e9e9e9}
h2{margin:0 0 4px}h3{margin:16px 0 8px;font-size:15px;color:#9ab}
table{width:100%;border-collapse:collapse;font-size:13.5px}
th,td{padding:6px 8px;border-bottom:1px solid #232a36;text-align:left}
th{color:#8ea;font-size:12.5px}
.g{color:#3c9}.y{color:#fc6}.r{color:#f66}.m{color:#889}
.bar{display:inline-block;height:9px;background:#7af;border-radius:2px;vertical-align:middle}
.wm{position:fixed;right:12px;bottom:8px;color:#556;font-size:12px}
</style></head><body>
<h2>网络波动监测</h2>
<p style="color:#889;font-size:13px;margin:0">作者：au学长 V：aauuo0　每 10 秒测一轮（每轮各目标 5 个包，间隔 1 秒超时）</p>
<div class="wm">作者：au学长 V：aauuo0</div>
EOF
echo "<p><a href='?run' style='color:#7af'>立即测一次</a>　<a href='?clear' style='color:#f88'>清空记录</a></p>"
echo "<h3>最近 ${LOG##*/} 记录</h3>"
if [ -s "$LOG" ]; then
	# 计算公网 RTT 抖动（相邻两次差值平均）
	jit="$(awk -F'|' '{split($4,a,"|"); v=a[1]+0; if(p>0){d=v-p; if(d<0)d=-d; s+=d; n++} p=v} END{ if(n) printf "%.1f", s/n; else printf "0" }' "$LOG")"
	echo "<p>公网 RTT 抖动（平均相邻差）：<b>$jit ms</b>　<span class=m>（<10 好，10~30 一般，>30 游戏会明显卡顿）</span></p>"
	echo "<table><tr><th>时间</th><th>网关</th><th>223.5.5.5</th><th>119.29.29.29</th><th>波动图（119.29）</th><th>下行/上行 KB/s</th></tr>"
	awk -F'|' '{
		function cls(v,l){ if(l>5) return "r"; if(v>120||l>1) return "y"; return "g" }
		split($2,g,"|"); split($3,d1,"|"); split($4,d2,"|"); split($5,r,"|")
		w = d2[1]; bar = w/300*60; if (bar>60) bar=60; if (bar<1) bar=1
		printf "<tr><td>%s</td><td class=%s>%s ms / %s%%</td><td class=%s>%s ms / %s%%</td><td class=%s>%s ms / %s%%</td><td><span class=bar style=\"width:%dpx\"></span> %s ms</td><td class=m>%s / %s</td></tr>\n", \
			$1, cls(g[1],g[2]), g[1], g[2], cls(d1[1],d1[2]), d1[1], d1[2], cls(d2[1],d2[2]), d2[1], d2[2], bar, d2[1], r[1], r[2]
	}' "$LOG"
	echo "</table>"
	echo "<p class=m>颜色：<span class=g>绿=良好</span>　<span class=y>黄=RTT>120ms 或丢包>1%</span>　<span class=r>红=丢包>5%</span></p>"
else
	echo "<p class=m>还没有记录，页面每 10 秒会自动测一轮（也可以点上面的「立即测一次」）。</p>"
fi
cat <<'EOF'
<h3>说明</h3>
<p class=m style="font-size:13px">
· <b>网关</b>=到路由器本身，反映 WiFi/内网质量（这行抖动大 → 问题在你和路由器之间）。<br>
· <b>223.5.5.5 / 119.29.29.29</b>=到公网骨干，反映宽带和校园网出口质量（这两行抖动大 → 问题在运营商/学校侧）。<br>
· <b>抖动</b>用相邻两次 RTT 差值平均，游戏最关键的就是它；<b>丢包</b>比延迟更要命。<br>
· 想边玩游戏边观察：把这个页面开着（10 秒自动刷新），卡顿的瞬间回来看哪一行飙红。
</p>
</body></html>
EOF
