#!/bin/sh
# WAN MAC 工具（应急用）：随机化 / 恢复 / 自定义   by au学长 V：aauuo0
O=/etc/mac-orig
WANDEV="$(uci -q get network.wan.device)"; [ -n "$WANDEV" ] || WANDEV="$(ip route show default 2>/dev/null | awk '/^default/{print $5;exit}')"
curmac() { ip link show "$WANDEV" 2>/dev/null | awk '/link\/ether/{print $2;exit}'; }
randmac() { awk 'BEGIN{srand();s="26";for(i=1;i<=5;i++) s=s sprintf(":%02x", int(rand()*256)); print s}'; }
q="$(printf '%s' "$QUERY_STRING")"
a="$(printf '%s' "$q" | sed -n 's/.*a=\([a-z_]*\).*/\1/p')"
m="$(printf '%s' "$q" | sed -n 's/.*m=\([0-9a-fA-F:]\{17\}\).*/\1/p')"
msg=""
case "$a" in
	save_orig)
		[ -f "$O" ] || { curmac >"$O"; msg="已把当前 MAC 存为原始：$(cat "$O")"; }
		[ -f "$O" ] && [ "$(cat "$O")" != "$(curmac)" ] && msg="原始记录已存在：$(cat "$O")"
		;;
	rand)  n="$(randmac)"; uci -q set network.wan.macaddr="$n"; uci -q commit network; ifup wan 2>/dev/null; msg="WAN MAC 已随机化为 $n（正在重启 WAN，约 10~20 秒后重新认证）";;
	apply) [ -n "$m" ] && { uci -q set network.wan.macaddr="$m"; uci -q commit network; ifup wan 2>/dev/null; msg="WAN MAC 已设为 $m"; } || msg="MAC 格式不对";;
	restore) [ -f "$O" ] && { uci -q set network.wan.macaddr="$(cat "$O")"; uci -q commit network; ifup wan 2>/dev/null; msg="已恢复原始 MAC：$(cat "$O")"; } || msg="没有原始记录，请先点「记住当前 MAC」";;
	clear)  uci -q delete network.wan.macaddr; uci -q commit network; ifup wan 2>/dev/null; msg="已改回随机（由驱动默认），重启 WAN";;
esac
printf 'Content-Type: text/html; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
cat <<'EOF'
<!DOCTYPE html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>WAN MAC 工具</title><style>
:root{--line:rgba(128,146,184,.22);--card:rgba(127,140,170,.07);--fg:#e9e9e9;--dim:#8b96a8}
*{box-sizing:border-box}
body{font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;margin:0;padding:12px 14px 32px;
     background:#11141a;color:var(--fg);font-size:14px;line-height:1.55}
h2{margin:0 0 4px;font-size:19px;display:flex;align-items:center;gap:8px}
h3{margin:18px 0 8px;font-size:14px;color:#9ab;font-weight:600}
.tag{font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;background:rgba(94,114,228,.18);
     color:#93a4f2;border:1px solid rgba(94,114,228,.35)}
.sub{color:var(--dim);font-size:12.5px;margin:0 0 14px}
a.b{display:inline-block;padding:8px 14px;margin:0 8px 8px 0;border-radius:10px;background:var(--card);
    border:1px solid var(--line);color:#dfe6f0;text-decoration:none;font-size:13px;transition:all .15s}
a.b:hover{border-color:#5e72e4;background:rgba(94,114,228,.14)}
pre{background:#0d1016;border:1px solid var(--line);padding:12px;border-radius:10px;font-size:12.5px;
    line-height:1.6;white-space:pre-wrap;font-family:ui-monospace,Consolas,monospace}
.warn{background:rgba(224,96,96,.12);border:1px solid rgba(224,96,96,.4);border-left:3px solid #e55;
      padding:12px 14px;border-radius:10px;color:#f3a0a0;font-size:13px;line-height:1.8}
input{background:#0d1016;border:1px solid var(--line);color:#dfe6f0;border-radius:10px;padding:7px 10px;
      width:190px;max-width:100%;font-size:13px}
input:focus{outline:none;border-color:#5e72e4}
button{background:linear-gradient(135deg,#5e72e4,#483d8b);color:#fff;border:0;border-radius:10px;
       padding:8px 16px;font-size:13px;cursor:pointer}
.wm{position:fixed;left:0;right:0;top:38%;z-index:0;text-align:center;white-space:nowrap;pointer-events:none;user-select:none;transform:rotate(-22deg);font-size:clamp(26px,5.5vw,62px);font-weight:700;letter-spacing:.08em;color:rgba(128,140,168,.085)}
.wmc{position:fixed;right:14px;bottom:8px;z-index:9;font-size:12px;pointer-events:none;user-select:none;color:rgba(128,140,168,.55)}
</style></head><body>
<h2>WAN MAC 工具 <span class="tag">只改 WAN 口</span></h2>
<p class="sub">作者：au学长 V：aauuo0</p>
<div class="warn"><b>先读这段再用：</b><br>
· 只影响<b>路由器 WAN 口</b>的 MAC（学校能看到的就是它）；内网设备 MAC 学校看不到。<br>
· 改完会<b>断网 10~30 秒</b>并需要重新认证；同一账号频繁换 MAC 在学校侧看<b>更像异常</b>，可能触发风控。<br>
· 如果学校是"MAC 首次绑定/白名单"，换 MAC 可能导致<b>上不了网</b>，要用下面的「恢复原始 MAC」切回来。<br>
· 建议：<b>先点一次「记住当前 MAC」</b>再动别的，任何时候都能一键还原。</div>
EOF
echo "<h3>当前状态</h3><pre>"
echo "WAN 设备 : ${WANDEV:-(未检出)}"
echo "当前 MAC : $(curmac)"
echo "配置指定 : $(uci -q get network.wan.macaddr || echo '（未指定，用驱动默认）')"
echo "原始记录 : $(cat "$O" 2>/dev/null || echo '（还没保存）')"
echo "</pre>"
[ -n "$msg" ] && echo "<pre style='color:#3c9'>$msg</pre>"
cat <<'EOF'
<h3>操作</h3>
<p><a class="b" href="?a=save_orig">记住当前 MAC（原始）</a>
<a class="b" href="?a=rand">随机化 WAN MAC + 重启 WAN</a>
<a class="b" href="?a=restore">恢复原始 MAC</a>
<a class="b" href="?a=clear">删除配置（用驱动默认）</a></p>
<h3>指定一个 MAC</h3>
<form method="get"><input name="m" placeholder="02:11:22:33:44:55"><input type="hidden" name="a" value="apply"><button type="submit">应用</button></form>
<p style="color:#889;font-size:12.5px">格式：六组十六进制，冒号分隔。建议第一字节用 02/06/0A/0E 之类（本地管理地址，避免和真实厂商段冲突）。</p>
<div class="wm">作者：au学长 V：aauuo0</div>
<div class="wmc">作者：au学长 V：aauuo0</div>
</body></html>
EOF
