#!/bin/sh
# ================================================================
# uadetect-web —— 「UA 防检测中心」网页版的后端助手
# 网页只能调用下面这几个固定动作，拿不到 shell。
#   uadetect-web status            输出当前状态（KEY=value）
#   uadetect-web use_ua3f          切到 UA3F
#   uadetect-web use_ua2f          切到 UA2F
#   uadetect-web stop              整套停用
#   uadetect-web apply             按当前配置重新应用
#   uadetect-web reset             复位成默认配置再应用
#   uadetect-web persona iphone    改人格（iphone/android/windows）
#   uadetect-web ttl 64            改固定 TTL
#   uadetect-web set <key> <value> 改其它开关（见 /etc/config/uadetect）
# ================================================================

PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH
export PATH

CTL=/usr/sbin/ua-detect-ctl
[ -x "$CTL" ] || { echo "ERROR: $CTL 不存在"; exit 1; }

case "$1" in
	status)   "$CTL" status ;;
	use_ua3f) "$CTL" set use_ua3f 1 ;;
	use_ua2f) "$CTL" set use_ua2f 1 ;;
	stop)     "$CTL" set stop 1 ;;
	apply)    "$CTL" set apply 1 ;;
	reset)    "$CTL" set reset 1 ;;
	persona)  { [ -n "$2" ] && "$CTL" set persona "$2"; } || exit 1 ;;
	ttl)      { [ -n "$2" ] && "$CTL" set ttl "$2"; } || exit 1 ;;
	set)      { [ -n "$2" ] && [ -n "$3" ] && "$CTL" set "$2" "$3"; } || exit 1 ;;
	*)
		echo "用法: uadetect-web status|use_ua3f|use_ua2f|stop|apply|reset|persona <p>|ttl <n>|set <k> <v>" >&2
		exit 1
		;;
esac
