#!/bin/sh
# 后台网络采样器：每 30 秒一行写 /tmp/netmon.log   by au学长 V：aauuo0
# 列：时间 网关avg 网关loss 公网1avg 公网1loss 公网2avg 公网2loss TCP握手ms 下行KB/s 上行KB/s
LOG=/tmp/netmon.log
D1=223.5.5.5
D2=119.29.29.29
MAX=5760        # 保留 5760 行 = 48 小时（30 秒一行）

while true; do
	GW="$(ip route show default 2>/dev/null | awk '/^default/{print $3;exit}')"
	IF="$(ip route show default 2>/dev/null | awk '/^default/{print $5;exit}')"
	# 三个 ping + TCP 握手 + 速率，全部并行
	ping -c 3 -W 1 -q "$GW" 2>/dev/null | awk '/round-trip/{split($4,a,"/");printf "%s",a[2]} /packet loss/{split($0,b," ");for(i=1;i<=NF;i++) if($i ~ /%/) printf "|%d",$i+0}' >/tmp/_s_g &
	ping -c 3 -W 1 -q "$D1" 2>/dev/null | awk '/round-trip/{split($4,a,"/");printf "%s",a[2]} /packet loss/{for(i=1;i<=NF;i++) if($i ~ /%/) printf "|%d",$i+0}' >/tmp/_s_d1 &
	ping -c 3 -W 1 -q "$D2" 2>/dev/null | awk '/round-trip/{split($4,a,"/");printf "%s",a[2]} /packet loss/{for(i=1;i<=NF;i++) if($i ~ /%/) printf "|%d",$i+0}' >/tmp/_s_d2 &
	tcp="$(curl -s -o /dev/null -m 3 -w '%{time_connect}' http://$D1 2>/dev/null | awk '{printf "%.0f", $1*1000}')"
	cur="$(awk -v i="$IF:" '$1==i{gsub(/^ +/,"",$2); print $2" "$10}' /proc/net/dev 2>/dev/null)"
	prev="$(cat /tmp/_s_prev 2>/dev/null)"; printf '%s' "$cur" >/tmp/_s_prev
	wait
	rt="$(printf '%s\n%s\n' "$prev" "$cur" | awk 'NR==1{r=$1;t=$2} NR==2{d=$1-r;e=$2-t; if(d<0)d=0; if(e<0)e=0; printf "%d %d", d/1024/30, e/1024/30}')"
	g="$(cat /tmp/_s_g)"; d1="$(cat /tmp/_s_d1)"; d2="$(cat /tmp/_s_d2)"
	[ -n "$g" ]  || g="0|100"
	[ -n "$d1" ] || d1="0|100"
	[ -n "$d2" ] || d2="0|100"
	printf '%s %s %s %s %s %s %s %s %s %s\n' "$(date '+%m-%d %H:%M:%S')" \
		"${g%%|*}" "${g##*|}" "${d1%%|*}" "${d1##*|}" "${d2%%|*}" "${d2##*|}" "${tcp:-0}" $rt >>"$LOG"
	tail -n "$MAX" "$LOG" >"$LOG.t" 2>/dev/null && mv "$LOG.t" "$LOG"
	sleep 30
done
