#!/bin/sh
# Dr.COM 自动登录巡检循环：procd 负责拉起和守护本脚本。
# 间隔从 UCI 读取，允许 10~3600 秒，默认 60 秒。

while :; do
	/usr/bin/drcom-auth >/dev/null 2>&1

	interval=$(uci -q get drcomauth.main.interval 2>/dev/null)
	case "$interval" in
		''|*[!0-9]*) interval=60 ;;
	esac
	[ "$interval" -lt 10 ] 2>/dev/null && interval=10
	[ "$interval" -gt 3600 ] 2>/dev/null && interval=3600

	sleep "$interval"
done
