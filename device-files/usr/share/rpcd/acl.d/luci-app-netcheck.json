{
	"luci-app-netcheck": {
		"description": "Grant access to the netcheck campus network login service",
		"read": {
			"file": {
				"/etc/auth.conf": [ "read" ],
				"/etc/netcheck.conf": [ "read" ],
				"/tmp/netcheck.log": [ "read" ],
				"/tmp/auth_last.log": [ "read" ],
				"/tmp/netcheck_test.log": [ "read" ],
				"/etc/init.d/netcheck": [ "exec" ],
				"/usr/libexec/netcheck-web": [ "exec" ]
			},
			"ubus": {
				"service": [ "list" ]
			}
		},
		"write": {
			"file": {
				"/etc/auth.conf": [ "write" ],
				"/etc/netcheck.conf": [ "write" ]
			}
		}
	}
}
