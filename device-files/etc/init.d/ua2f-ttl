#!/bin/sh /etc/rc.common
# =====================================================================
#  开机把出站 TTL 固定成 64（多设备共享检测里最常查的一项）
#  由 ua2f.main.fix_ttl 控制；UA2F 本身只改 UA，不碰 TTL。
# =====================================================================
START=99
STOP=10

apply() {
	[ "$(uci -q get ua2f.main.fix_ttl)" = "1" ] || return 0
	# UA3F 在跑就别插第二条 TTL 规则
	if pgrep -f /usr/bin/ua3f >/dev/null 2>&1; then
		logger -t ua2f-ttl "UA3F 运行中，跳过 TTL 规则"
		return 0
	fi
	ttl="$(uci -q get ua2f.main.fix_ttl_value)"
	[ -n "$ttl" ] || case "$(uci -q get ua2f.main.persona)" in
		windows) ttl=128 ;;
		*)       ttl=64 ;;
	esac
	command -v nft >/dev/null 2>&1 || return 0
	nft list table ip ua2f_ttl >/dev/null 2>&1 || nft add table ip ua2f_ttl
	nft list chain ip ua2f_ttl postrouting >/dev/null 2>&1 || \
		nft 'add chain ip ua2f_ttl postrouting { type filter hook postrouting priority mangle; }' 2>/dev/null
	nft flush chain ip ua2f_ttl postrouting 2>/dev/null
	nft add rule ip ua2f_ttl postrouting ip ttl set "$ttl" 2>/dev/null
	logger -t ua2f-ttl "已固定出站 TTL = $ttl"
}

clear() {
	nft delete table ip ua2f_ttl 2>/dev/null
}

start() { apply; }
stop()  { clear; }
reload(){ clear; apply; }
