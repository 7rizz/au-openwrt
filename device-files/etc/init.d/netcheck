#!/bin/sh /etc/rc.common
# ================================================================
# /etc/init.d/netcheck -- start netcheck.sh at boot and keep it alive.
#   installed by the "netcheck" package
#
#   /etc/init.d/netcheck enable    start it automatically at boot
#   /etc/init.d/netcheck start     start it now
#   /etc/init.d/netcheck stop      stop it
#   /etc/init.d/netcheck restart   restart it
# ================================================================

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/netcheck.sh
	procd_set_param respawn
	procd_set_param file /etc/netcheck.conf
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
