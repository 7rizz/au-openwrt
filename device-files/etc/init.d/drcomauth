#!/bin/sh /etc/rc.common
# ============================================================
#  Dr.COM 哆点（润泽公寓）自动登录服务
#
#  由 procd 托管：/usr/libexec/drcomauth-loop 常驻，
#  每 interval 秒调用一次 /usr/bin/drcom-auth（默认 60 秒）。
#  掉线时自动重新认证；已在线时只更新状态，不重复登录。
# ============================================================

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/drcomauth-loop
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger drcomauth
}
