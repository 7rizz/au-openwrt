#!/bin/sh /etc/rc.common
# 网络波动监测 · 后台采样服务（每 30 秒一行日志）  by au学长 V：aauuo0
START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /usr/libexec/netmon-sample
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() { :; }
reload() { :; }
