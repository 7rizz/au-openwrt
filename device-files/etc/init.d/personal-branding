#!/bin/sh /etc/rc.common
# =====================================================================
#  固件显示名 —— LuCI「状态 → 概况」里那行「固件版本」
#  每次开机校正一次，保证系统升级后名字也不会丢。
#  想改名字，只改下面 FW_NAME 这一行。
# =====================================================================

START=19
STOP=90

FW_NAME='by au VX：aauuo0 倒卖司马'

start() {
	[ -f /etc/openwrt_release ] || exit 0
	# 顺便兜底：若 root 密码是空的、而固件里带了编译时算好的密码哈希，就补上，
	# 避免后台一直提示“未设置密码”。（想故意留空密码：删掉 /etc/rootpw.hash 即可）
	if [ -s /etc/rootpw.hash ]; then
		cur="$(sed -n 's/^root:\([^:]*\):.*/\1/p' /etc/shadow 2>/dev/null)"
		if [ -z "$cur" ]; then
			h="$(cat /etc/rootpw.hash 2>/dev/null)"
			case "$h" in
				\$1\$*|\$5\$*|\$6\$*)
					sed -i "s|^root:[^:]*:|root:$h:|" /etc/shadow
					;;
			esac
		fi
	fi

	grep -q '^DISTRIB_DESCRIPTION=' /etc/openwrt_release || exit 0
	# 已经是我们的名字就不重复写（少写一次 flash）
	grep -qF "DISTRIB_DESCRIPTION='$FW_NAME'" /etc/openwrt_release && exit 0
	sed -i "s|^DISTRIB_DESCRIPTION=.*|DISTRIB_DESCRIPTION='$FW_NAME'|" /etc/openwrt_release
}
