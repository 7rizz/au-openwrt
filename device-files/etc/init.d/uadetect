#!/bin/sh /etc/rc.common
# UA 防检测中心 · 开机应用配置

START=99
STOP=10

start() {
	/usr/sbin/ua-detect-ctl apply
}

stop() {
	/etc/init.d/ua3f stop 2>/dev/null
	/etc/init.d/ua3f disable 2>/dev/null
	service ua2f stop 2>/dev/null
	service ua2f disable 2>/dev/null
	/usr/sbin/ua-detect-ctl firewall-off 2>/dev/null
}

restart() {
	stop
	start
}

reload() {
	start
}

