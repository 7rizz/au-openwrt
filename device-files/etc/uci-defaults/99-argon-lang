#!/bin/sh
# =====================================================================
#  首次开机：把 Argon 主题 + 中文界面钉死（by au学长 V：aauuo0）
#  这两个东西现在是直接放进固件的（不是靠 opkg 装），所以只要文件在，
#  这一脚本就能保证主题和语言被正确选上。
# =====================================================================

# ---------- 主题 ----------
if [ -d /www/luci-static/argon ]; then
	uci -q set luci.themes.Argon='/luci-static/argon'
	uci -q set luci.main.mediaurlbase='/luci-static/argon'
fi

# ---------- 语言 ----------
# 24.10 的 dispatcher 会把下划线换成横线再去找 /usr/lib/lua/luci/i18n/*.lmo，
# 所以 luci.main.lang 用哪种写法都认，前提是对应的 .lmo 真的在。
for c in zh-cn zh_Hans zh_cn; do
	if ls /usr/lib/lua/luci/i18n/*."$c".lmo >/dev/null 2>&1; then
		uci -q set luci.main.lang="$c"
		case "$c" in
			zh-cn) uci -q set luci.languages.zh_cn='简体中文 (Simplified Chinese)' ;;
			*)     uci -q set "luci.languages.$c"='简体中文' ;;
		esac
		break
	fi
done

# ---------- 主题设置：路由器常在校园网里没外网，别用在线壁纸 ----------
# 想要必应每日壁纸的话，在「系统 -> Argon Config」里改成 bing 即可。
uci -q set argon.@global[0].online_wallpaper='none'

uci -q commit luci
uci -q commit argon 2>/dev/null
exit 0
