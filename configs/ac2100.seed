# =====================================================================
#  红米 AC2100（Xiaomi Redmi Router AC2100）私人固件配置
#  本文件会被编译脚本复制成 OpenWrt 源码里的 .config，
#  然后自动执行 make defconfig 补全依赖。
#
#  想删某个功能：在这一行最前面加 #     想加：新起一行 CONFIG_PACKAGE_包名=y
#  写错/不存在的包名不会导致编译失败，会被自动忽略。
# =====================================================================

# ---------- 1. 目标设备（这块不要动） ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_redmi-router-ac2100=y

# ---------- 2. LuCI 基础 + Argon 主题 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-mod-dashboard=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---------- 3. 中文语言包 ----------
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dashboard-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-attendedsysupgrade-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ---------- 3c. Argon 主题（支持 24.10）+ 它的设置页 ----------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ---------- 3b. 校园网防检测（UA3F / UA2F 已内置在固件里，这里是它们的运行依赖） ----------
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-ipset=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_iptables-mod-nfqueue=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_ip-full=y
# UA2F 的运行库（UA2F 本身随 device-files 进镜像，这里保证动态库齐）
CONFIG_PACKAGE_libatomic1=y
CONFIG_PACKAGE_libmnl0=y
CONFIG_PACKAGE_libnetfilter-queue1=y
CONFIG_PACKAGE_libnetfilter-conntrack3=y
CONFIG_PACKAGE_libnfnetlink0=y
CONFIG_PACKAGE_tcpdump=y

# ---------- 4. 科学上网三件套（都装了但不自动启动，用哪个开哪个） ----------
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-ssr-plus=y

# ---------- 5. DNS / 广告过滤 ----------
CONFIG_PACKAGE_luci-app-adguardhome=y

# ---------- 6. 网络增强 ----------
# 注意：mwan3 会和 UA2F/UA3F 抢 connmark，同时启用会让防检测引擎报错（恩山论坛反馈）
# 要用多拨就单独开，别和防检测同时跑
CONFIG_PACKAGE_luci-app-mwan3=y          # 多拨 / 多线负载均衡
CONFIG_PACKAGE_luci-app-sqm=y            # 智能限速（游戏/看视频不卡）
CONFIG_PACKAGE_luci-app-upnp=y           # UPnP 端口自动映射
CONFIG_PACKAGE_luci-app-ddns=y           # 动态域名解析
CONFIG_PACKAGE_luci-app-wol=y            # 网络唤醒
CONFIG_PACKAGE_luci-app-autoreboot=y     # 定时重启

# ---------- 7. 系统工具 ----------
CONFIG_PACKAGE_luci-app-ttyd=y           # 网页终端
CONFIG_PACKAGE_luci-app-commands=y       # 自定义命令按钮
CONFIG_PACKAGE_openssh-sftp-server=y     # 方便用 WinSCP 传文件
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_openssl-util=y          # 润泽公寓 Dr.COM 登录要用 aes-128-ecb
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# ---------- 8. 把 dnsmasq 换成 full 版（代理插件需要） ----------
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq=n

# ---------- 9. 让 busybox 带 cryptpw（首次开机自动设 root 密码用） ----------
CONFIG_BUSYBOX_CONFIG_CRYPTPW=y
CONFIG_PACKAGE_libgcc1=y

# ---------- 10. 可选功能：想要就把 # 删掉 ----------
# CONFIG_PACKAGE_luci-app-mosdns=y         # 本地 DNS 分流，很好用但约 10MB
# CONFIG_PACKAGE_luci-app-smartdns=y       # 另一套 DNS 加速
# CONFIG_PACKAGE_luci-app-zerotier=y       # 异地组网 / 内网穿透
# CONFIG_PACKAGE_luci-app-frpc=y           # 内网穿透（花生壳/FRP）
# CONFIG_PACKAGE_luci-app-filetransfer=y   # 网页上传下载文件
# CONFIG_PACKAGE_luci-app-nat6-helper=y    # IPv6 支持增强
# CONFIG_PACKAGE_luci-app-dockerman=y      # Docker（AC2100 只有 128MB 内存，不建议）

